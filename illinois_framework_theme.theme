      'il-icon-video'         => 'video-line',
      'il-icon-volume'        => 'volume-line',
      'il-icon-website'       => 'website-line',
      'il-icon-weibo'         => 'weibo-line',
      'il-icon-whatsapp'      => 'whatsapp-line',
