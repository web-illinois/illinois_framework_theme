{#
/**
 * @file
 * Template implementation for the media_remote_npr theme hook.
 *
 * Available variables:
 * - url: (string) The full URL to this document.
 * - width: (int) The width of the iframe, in pixels.
 * - height: (int) The height of the iframe, in pixels.
 */
#}
<div class="field--name-field-media-oembed-video">
<iframe title="Embedded content from Media Space (https://mediaspace.illinois.edu/)" allowfullscreen="allowfullscreen" src="{{ url }}" width="{{ width }}" height="{{ height }}" frameborder="0"></iframe>
</div>
