{#
/**
 * @file
 * Theme override for a local task link.
 *
 * Available variables:
 * - attributes: HTML attributes for the list item.
 * - link: The link element.
 *
 * @see template_preprocess_menu_local_task()
 */
#}
{%
  set classes = [
    'local-tasks__item',
    is_active ? 'is-active',
  ]
%}
<li{{ attributes.addClass(classes) }}>{{ link }}</li>
