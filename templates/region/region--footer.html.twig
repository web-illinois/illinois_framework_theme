{#
/**
 * @file
 * Theme override to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see template_preprocess_region()
 */
#}
{% if if_secondary_site_title %}
  {% if if_secondary_site_link %}
    <a slot="primary-unit" href="{{ if_secondary_site_link }}">{{ if_secondary_site_title }}</a>
  {% else %}
    <a slot="primary-unit" href="#">{{ if_secondary_site_title }}</a>
  {% endif %}
{% endif %}
<a slot="site-name" href="/">{{ drupal_config('system.site', 'name') | raw }}</a>
{% if if_footer['if_footer_social'] %}
<nav slot="social" aria-label="Social media">
  <ul>
  {% for socialname, sociallink in if_footer['if_footer_social'] %}
        <li><a href="{{ sociallink }}"><ilw-icon alt="{{ socialname }}" icon="{{ socialname }}" size="44px"></ilw-icon></a></li>
      {% endfor %}
  </ul>
</nav>
{% endif %}
<address slot="address">
  <p>
    {% if if_footer['if_footer_address']['if_footer_address_street_one'] %}
      {{ if_footer['if_footer_address']['if_footer_address_street_one'] }}
    {% endif %}
  </p>
  {% if if_footer['if_footer_address']['if_footer_address_street_two'] %}
    <p>{{ if_footer['if_footer_address']['if_footer_address_street_two'] }}</p>
  {% endif %}
  <p>
    {% if if_footer['if_footer_address']['if_footer_address_city'] %}
      {{ if_footer['if_footer_address']['if_footer_address_city'] }},
    {% endif %}
    {% if if_footer['if_footer_address']['if_footer_address_state'] %}
      {{ if_footer['if_footer_address']['if_footer_address_state'] }}
    {% endif %}
    {% if if_footer['if_footer_address']['if_footer_address_zip'] %}
      {{ if_footer['if_footer_address']['if_footer_address_zip'] }}
    {% endif %}
  </p>
  {% if if_footer['if_footer_address']['if_footer_address_tel'] %}
    <p><a href="tel:{{ if_footer['if_footer_address']['if_footer_address_tel'] }}">{{ if_footer['if_footer_address']['if_footer_address_tel'] }}</a></p>
  {% endif %}
  {% if if_footer['if_footer_address']['if_footer_address_email'] %}
    <p>Email: <a href="mailto:{{ if_footer['if_footer_address']['if_footer_address_email'] }}">{{ if_footer['if_footer_address']['if_footer_address_email'] }}</a></p>
  {% endif %}
  {% if if_footer_colleges %}
    <div class="footer-colleges">
      {% for item in if_footer_colleges %}
        {% if if_footer_colleges[loop.index0][0] != "" %}
          {% set title = if_footer_colleges[loop.index0][0] %}
          {% set url = if_footer_colleges[loop.index0][1] %}
          <div><a href="{{ url }}">{{ title }}</a></div>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}
</address>
<div slot="actions">
  {% for subfooter_link in if_subfooter|slice(0,2) %}
    {% set link = subfooter_link[1] %}
    {% set text = subfooter_link[0] %}
    {% if link != NULL or text != NULL %}
      <a href="{{ link }}">{{ text }}</a>
    {% endif %}
  {% endfor %}
  <a href="{{ login_logout_url }}" rel="nofollow">{{ login_logout_text }}</a>
</div>

{# This variable footermenus helps with initial render (render once), shortens the section for the menu footers and
  enables checking if content is present. #}
{% set footermenus = [ drupal_entity('block', 'footermenufirst')|render,
                        drupal_entity('block', 'footermenusecond')|render,
                        drupal_entity('block', 'footermenuthird')|render,
                        drupal_entity('block', 'footermenufourth')|render ]
%}
{# if any footermenu rendered, show the container #}
{% if footermenus[0] is not empty or footermenus[1] is not empty or
footermenus[2] is not empty or footermenus[3] is not empty %}
<div class="footer-menus">
  <div>{# Keep the div even if blank so that CSS grid works properly #}
  {% if footermenus[0] is not empty or footermenus[1] is not empty%}
    {{ footermenus[0] }}
    {{ footermenus[1] }}
  {% endif %}
  </div>
  <div>{# Keep the div even if blank so that CSS grid works properly #}
  {% if footermenus[2] is not empty or footermenus[3] is not empty%}
    {{ footermenus[2] }}
    {{ footermenus[3] }}
  {% endif %}
  </div>
</div>
{% endif %}
{# Remove below per Illinois_Framework_Theme #1313
{% if if_footer_google_translate ?? true %}
  <div class="google-translate-wrapper">
    <div id="google_translate_element"></div>
  </div>
